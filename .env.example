# Copy to .env.local (git-ignored) and fill in. Standard: reops/standards/env.md
# Names only: no value is ever written here. None of these is a secret: Vite bakes them into the build.

# --- Firebase web app (sign-in with e-mail and password, and with Google) -----------------------------------
# From the Firebase console: Project settings, General, Your apps, the web app, "firebaseConfig".
# GitHub: repository variables. Empty = the sign-in is off and only the demo works.
# On Firebase Hosting VITE_FIREBASE_AUTH_DOMAIN is the app's own address (<project>.web.app or the custom domain),
# so Google sign-in runs on the same site.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- API ----------------------------------------------------------------------------------------------------
# Address of an API on another origin, with /api at the end. Optional. Empty = /api on the app's own origin (Firebase
# Hosting rewrites it to Cloud Run; `pnpm dev` proxies it to VITE_API_PROXY).
VITE_API_URL=

# Where `pnpm dev` and `pnpm preview` send /api. Optional. Empty = http://localhost:8080 (finance-tracker-api run locally).
VITE_API_PROXY=

# --- Health check (scripts/health-check.ts) -----------------------------------------------------------------
# The address of the live app. Required by `pnpm health`.
SITE_URL=
